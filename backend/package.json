{
  "name": "SolveKey-backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "dev:local": "node --env-file=.env.local --watch src/index.js",
    "start": "node src/index.js",
    "mcp": "node mcp/server.js",
    "migrate": "node db/migrate.js",
    "migrate:local": "node --env-file=.env.local db/migrate.js",
    "seed": "node scripts/seed.js",
    "seed:local": "node --env-file=.env.local scripts/seed.js",
    "db:local": "node --env-file=.env.local scripts/local-postgres.js",
    "test": "node --test test/*.test.js",
    "test:pipeline": "node scripts/test-pipeline.js"
  },
  "dependencies": {
    "@google/genai": "^3.2.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19"
  }
}
